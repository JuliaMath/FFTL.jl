! The legacy Fortran interface (Xfftw_*), precision WP: subroutines with the plan (or result)
! as first argument, dimensions in Fortran order. Generated per precision by fftw3_ftest.sh.
subroutine run_legacy_PREC()
  use ftest_ref
  implicit none
  include 'fftw3.f'
  integer*8 :: plan, plan2
  integer :: iret, seed, i, n(3), ie(2), oe(2), nn(2), is(2), os(2), hn(1), his(1), hos(1), kinds(2)
  complex(WP), allocatable :: x1(:), y1(:), x2(:,:), y2(:,:), x3(:,:,:), y3(:,:,:)
  real(WP), allocatable :: r2(:,:), s2(:,:), r1(:), xr(:,:), xi(:,:), yr(:,:), yi(:,:)
  complex(8), allocatable :: ref(:)
  real(8), allocatable :: rr(:), tmp(:)
  real(8) :: tol, add, mul, fma, c
  character(64) :: nm
  integer :: wcount
  external wcount_char
  common /wisdom_count/ wcount
  tol = TOLV
  seed = 7

  ! 1D complex, out of place, forward
  allocate(x1(12), y1(12), ref(12), tmp(24))
  call fill_r(tmp, 24, seed)
  x1 = cmplx(tmp(1:24:2), tmp(2:24:2), WP)
  ref = x1
  call Xfftw_plan_dft_1d(plan, 12, x1, y1, FFTW_FORWARD, FFTW_ESTIMATE)
  call Xfftw_execute_dft(plan, x1, y1)
  call dft_dim(ref, [12], 1, 1, -1)
  call check(relerr_c(cmplx(y1, kind=8), ref, 12) < tol, 'PREC legacy dft_1d')
  ! copy_plan, new arrays
  call Xfftw_copy_plan(plan2, plan)
  call Xfftw_destroy_plan(plan)
  y1 = 0
  call Xfftw_execute_dft(plan2, x1, y1)
  call check(relerr_c(cmplx(y1, kind=8), ref, 12) < tol, 'PREC legacy copy_plan')
  call Xfftw_cost(c, plan2)
  call Xfftw_flops(plan2, add, mul, fma)
  call check(c >= 0 .and. add >= 0 .and. mul >= 0 .and. fma >= 0 .and. add + mul + fma < huge(1d0), 'PREC legacy cost, flops')
  call Xfftw_destroy_plan(plan2)
  deallocate(x1, y1, ref, tmp)

  ! 2D complex 5 x 6, backward, FFTW_MEASURE (plan before filling)
  allocate(x2(5, 6), y2(5, 6), ref(30), tmp(60))
  call Xfftw_plan_dft_2d(plan, 5, 6, x2, y2, FFTW_BACKWARD, FFTW_MEASURE)
  call fill_r(tmp, 60, seed)
  x2 = reshape(cmplx(tmp(1:60:2), tmp(2:60:2), WP), [5, 6])
  ref = reshape(x2, [30])
  call Xfftw_execute_dft(plan, x2, y2)
  call dft_dim(ref, [5, 6], 2, 1, 1)
  call dft_dim(ref, [5, 6], 2, 2, 1)
  call check(relerr_c(reshape(cmplx(y2, kind=8), [30]), ref, 30) < tol, 'PREC legacy dft_2d backward')
  call Xfftw_destroy_plan(plan)
  ! the plan through fftw_execute (the manual advises the new-array form)
  call Xfftw_plan_dft_2d(plan, 5, 6, x2, y2, FFTW_BACKWARD, FFTW_ESTIMATE)
  call Xfftw_execute(plan)
  call check(relerr_c(reshape(cmplx(y2, kind=8), [30]), ref, 30) < tol, 'PREC legacy execute')
  call Xfftw_destroy_plan(plan)
  deallocate(x2, y2, ref, tmp)

  ! 3D complex 4 x 3 x 5 in place, and plan_dft of rank 3
  allocate(x3(4, 3, 5), y3(4, 3, 5), ref(60), tmp(120))
  call fill_r(tmp, 120, seed)
  x3 = reshape(cmplx(tmp(1:120:2), tmp(2:120:2), WP), [4, 3, 5])
  ref = reshape(x3, [60])
  call Xfftw_plan_dft_3d(plan, 4, 3, 5, x3, x3, FFTW_FORWARD, FFTW_ESTIMATE)
  call Xfftw_execute_dft(plan, x3, x3)
  do i = 1, 3
    call dft_dim(ref, [4, 3, 5], 3, i, -1)
  end do
  call check(relerr_c(reshape(cmplx(x3, kind=8), [60]), ref, 60) < tol, 'PREC legacy dft_3d in place')
  call Xfftw_destroy_plan(plan)
  n = [4, 3, 5]
  x3 = reshape(cmplx(tmp(1:120:2), tmp(2:120:2), WP), [4, 3, 5])
  call Xfftw_plan_dft(plan, 3, n, x3, y3, FFTW_FORWARD, FFTW_ESTIMATE)
  call Xfftw_execute_dft(plan, x3, y3)
  call check(relerr_c(reshape(cmplx(y3, kind=8), [60]), ref, 60) < tol, 'PREC legacy plan_dft rank 3')
  call Xfftw_destroy_plan(plan)
  deallocate(x3, y3, ref, tmp)

  ! r2c 7 x 4 (the first dimension halved), c2r back
  allocate(r2(7, 4), s2(7, 4), x2(4, 4), ref(28), rr(28))
  call fill_r(rr, 28, seed)
  r2 = reshape(real(rr, WP), [7, 4])
  ref = cmplx(reshape(real(r2, 8), [28]), 0d0, 8)
  call dft_dim(ref, [7, 4], 2, 1, -1)
  call dft_dim(ref, [7, 4], 2, 2, -1)
  call Xfftw_plan_dft_r2c_2d(plan, 7, 4, r2, x2, FFTW_ESTIMATE)
  call Xfftw_execute_dft_r2c(plan, r2, x2)
  call check(relerr_c(reshape(cmplx(x2, kind=8), [16]), head_rows(ref, 7, 4, 4), 16) < tol, 'PREC legacy dft_r2c_2d')
  call Xfftw_destroy_plan(plan)
  call Xfftw_plan_dft_c2r_2d(plan, 7, 4, x2, s2, FFTW_ESTIMATE)
  call Xfftw_execute_dft_c2r(plan, x2, s2)
  call check(relerr_r(reshape(real(s2, 8), [28]), 28 * reshape(real(r2, 8), [28]), 28) < 10 * tol, 'PREC legacy dft_c2r_2d')
  call Xfftw_destroy_plan(plan)
  ! the same through the rank interface
  nn = [7, 4]
  call Xfftw_plan_dft_r2c(plan, 2, nn, r2, x2, FFTW_ESTIMATE)
  call Xfftw_execute_dft_r2c(plan, r2, x2)
  call check(relerr_c(reshape(cmplx(x2, kind=8), [16]), head_rows(ref, 7, 4, 4), 16) < tol, 'PREC legacy dft_r2c rank 2')
  call Xfftw_destroy_plan(plan)
  deallocate(r2, s2, x2, ref, rr)
  ! r2c and c2r 1D
  allocate(r1(10), x1(6), ref(10), rr(10))
  call fill_r(rr, 10, seed)
  r1 = real(rr, WP)
  ref = cmplx(real(r1, 8), 0d0, 8)
  call dft_dim(ref, [10], 1, 1, -1)
  call Xfftw_plan_dft_r2c_1d(plan, 10, r1, x1, FFTW_ESTIMATE)
  call Xfftw_execute_dft_r2c(plan, r1, x1)
  call check(relerr_c(cmplx(x1, kind=8), ref(1:6), 6) < tol, 'PREC legacy dft_r2c_1d')
  call Xfftw_destroy_plan(plan)
  call Xfftw_plan_dft_c2r_1d(plan, 10, x1, r1, FFTW_ESTIMATE)
  call Xfftw_execute_dft_c2r(plan, x1, r1)
  call check(relerr_r(real(r1, 8), 10 * rr, 10) < 10 * tol, 'PREC legacy dft_c2r_1d')
  call Xfftw_destroy_plan(plan)
  deallocate(r1, x1, ref, rr)

  ! r2r 5 x 6: kind0 along the first Fortran dimension
  allocate(r2(5, 6), s2(5, 6), rr(30))
  call fill_r(rr, 30, seed)
  r2 = reshape(real(rr, WP), [5, 6])
  rr = reshape(real(r2, 8), [30])
  call Xfftw_plan_r2r_2d(plan, 5, 6, r2, s2, FFTW_REDFT10, FFTW_RODFT11, FFTW_ESTIMATE)
  call Xfftw_execute_r2r(plan, r2, s2)
  call r2r_dim(rr, [5, 6], 2, 1, FFTW_REDFT10)
  call r2r_dim(rr, [5, 6], 2, 2, FFTW_RODFT11)
  call check(relerr_r(reshape(real(s2, 8), [30]), rr, 30) < tol, 'PREC legacy r2r_2d kinds per dimension')
  call Xfftw_destroy_plan(plan)
  rr = reshape(real(r2, 8), [30])
  nn = [5, 6]
  kinds = [FFTW_REDFT01, FFTW_DHT]
  call Xfftw_plan_r2r(plan, 2, nn, r2, s2, kinds, FFTW_ESTIMATE)
  call Xfftw_execute_r2r(plan, r2, s2)
  call r2r_dim(rr, [5, 6], 2, 1, FFTW_REDFT01)
  call r2r_dim(rr, [5, 6], 2, 2, FFTW_DHT)
  call check(relerr_r(reshape(real(s2, 8), [30]), rr, 30) < tol, 'PREC legacy plan_r2r rank 2')
  call Xfftw_destroy_plan(plan)
  ! guru r2r: iodims (second dimension, first dimension), the kind array reversed
  rr = reshape(real(r2, 8), [30])
  nn = [6, 5]
  is = [5, 1]
  os = [5, 1]
  kinds = [FFTW_REDFT11, FFTW_HC2R]
  call Xfftw_plan_guru_r2r(plan, 2, nn, is, os, 0, hn, his, hos, r2, s2, kinds, FFTW_ESTIMATE)
  call Xfftw_execute_r2r(plan, r2, s2)
  call r2r_dim(rr, [5, 6], 2, 1, FFTW_REDFT11)
  call r2r_dim(rr, [5, 6], 2, 2, FFTW_HC2R)
  call check(relerr_r(reshape(real(s2, 8), [30]), rr, 30) < tol, 'PREC legacy guru_r2r kinds reversed')
  call Xfftw_destroy_plan(plan)
  deallocate(r2, s2, rr)

  ! advanced: 2 arrays of 4 x 5 inside 6 x 5 (distance 30) into 4 x 5 (distance 20)
  allocate(x3(6, 5, 2), y3(4, 5, 2), ref(40), tmp(120))
  call fill_r(tmp, 120, seed)
  x3 = reshape(cmplx(tmp(1:120:2), tmp(2:120:2), WP), [6, 5, 2])
  ref = reshape(cmplx(x3(1:4, :, :), kind=8), [40])
  nn = [4, 5]
  ie = [6, 5]
  oe = [4, 5]
  call Xfftw_plan_many_dft(plan, 2, nn, 2, x3, ie, 1, 30, y3, oe, 1, 20, FFTW_FORWARD, FFTW_ESTIMATE)
  call Xfftw_execute_dft(plan, x3, y3)
  call dft_dim(ref, [4, 5, 2], 3, 1, -1)
  call dft_dim(ref, [4, 5, 2], 3, 2, -1)
  call check(relerr_c(reshape(cmplx(y3, kind=8), [40]), ref, 40) < tol, 'PREC legacy plan_many_dft with embed')
  call Xfftw_destroy_plan(plan)
  deallocate(x3, y3, ref, tmp)
  ! advanced r2c: 3 lines of 10
  allocate(r2(10, 3), x2(6, 3), ref(30), rr(30))
  call fill_r(rr, 30, seed)
  r2 = reshape(real(rr, WP), [10, 3])
  ref = cmplx(reshape(real(r2, 8), [30]), 0d0, 8)
  call dft_dim(ref, [10, 3], 2, 1, -1)
  n(1) = 10
  call Xfftw_plan_many_dft_r2c(plan, 1, n, 3, r2, n, 1, 10, x2, [6], 1, 6, FFTW_ESTIMATE)
  call Xfftw_execute_dft_r2c(plan, r2, x2)
  call check(relerr_c(reshape(cmplx(x2, kind=8), [18]), head_rows(ref, 10, 3, 6), 18) < tol, &
             'PREC legacy plan_many_dft_r2c')
  call Xfftw_destroy_plan(plan)
  allocate(s2(10, 3))
  call Xfftw_plan_many_dft_c2r(plan, 1, n, 3, x2, [6], 1, 6, s2, n, 1, 10, FFTW_ESTIMATE)
  call Xfftw_execute_dft_c2r(plan, x2, s2)
  call check(relerr_r(reshape(real(s2, 8), [30]), 10 * reshape(real(r2, 8), [30]), 30) < 10 * tol, &
             'PREC legacy plan_many_dft_c2r')
  call Xfftw_destroy_plan(plan)
  deallocate(r2, s2, x2, ref, rr)

  ! guru: 4 x 6, transformed along the second dimension, the first a vector dimension
  allocate(x2(4, 6), y2(4, 6), ref(24), tmp(48))
  call fill_r(tmp, 48, seed)
  x2 = reshape(cmplx(tmp(1:48:2), tmp(2:48:2), WP), [4, 6])
  ref = reshape(cmplx(x2, kind=8), [24])
  call dft_dim(ref, [4, 6], 2, 2, -1)
  call Xfftw_plan_guru_dft(plan, 1, [6], [4], [4], 1, [4], [1], [1], x2, y2, FFTW_FORWARD, FFTW_ESTIMATE)
  call Xfftw_execute_dft(plan, x2, y2)
  call check(relerr_c(reshape(cmplx(y2, kind=8), [24]), ref, 24) < tol, 'PREC legacy plan_guru_dft')
  call Xfftw_destroy_plan(plan)
  ! the same with split arrays
  allocate(xr(4, 6), xi(4, 6), yr(4, 6), yi(4, 6))
  xr = real(x2, WP)
  xi = aimag(x2)
  call Xfftw_plan_guru_split_dft(plan, 1, [6], [4], [4], 1, [4], [1], [1], xr, xi, yr, yi, FFTW_ESTIMATE)
  call Xfftw_execute_split_dft(plan, xr, xi, yr, yi)
  call check(relerr_c(reshape(cmplx(yr, yi, 8), [24]), ref, 24) < tol, 'PREC legacy plan_guru_split_dft')
  call Xfftw_destroy_plan(plan)
  ! guru r2c along the first dimension (4 -> 3), split output, and c2r back
  allocate(r2(4, 6), s2(4, 6))
  r2 = xr
  ref = cmplx(reshape(real(r2, 8), [24]), 0d0, 8)
  call dft_dim(ref, [4, 6], 2, 1, -1)
  yr = 0
  yi = 0
  call Xfftw_plan_guru_split_dft_r2c(plan, 1, [4], [1], [1], 1, [6], [4], [4], r2, yr, yi, FFTW_ESTIMATE)
  call Xfftw_execute_split_dft_r2c(plan, r2, yr, yi)
  call check(relerr_c(reshape(cmplx(yr(1:3, :), yi(1:3, :), 8), [18]), head_rows(ref, 4, 6, 3), 18) &
             < tol, 'PREC legacy plan_guru_split_dft_r2c')
  call Xfftw_destroy_plan(plan)
  call Xfftw_plan_guru_split_dft_c2r(plan, 1, [4], [1], [1], 1, [6], [4], [4], yr, yi, s2, FFTW_ESTIMATE)
  call Xfftw_execute_split_dft_c2r(plan, yr, yi, s2)
  call check(relerr_r(reshape(real(s2, 8), [24]), 4 * reshape(real(r2, 8), [24]), 24) < 10 * tol, &
             'PREC legacy plan_guru_split_dft_c2r')
  call Xfftw_destroy_plan(plan)
  ! guru r2c and c2r, interleaved
  x2 = 0
  call Xfftw_plan_guru_dft_r2c(plan, 1, [4], [1], [1], 1, [6], [4], [4], r2, x2, FFTW_ESTIMATE)
  call Xfftw_execute_dft_r2c(plan, r2, x2)
  call check(relerr_c(reshape(cmplx(x2(1:3, :), kind=8), [18]), head_rows(ref, 4, 6, 3), 18) &
             < tol, 'PREC legacy plan_guru_dft_r2c')
  call Xfftw_destroy_plan(plan)
  call Xfftw_plan_guru_dft_c2r(plan, 1, [4], [1], [1], 1, [6], [4], [4], x2, s2, FFTW_ESTIMATE)
  call Xfftw_execute_dft_c2r(plan, x2, s2)
  call check(relerr_r(reshape(real(s2, 8), [24]), 4 * reshape(real(r2, 8), [24]), 24) < 10 * tol, &
             'PREC legacy plan_guru_dft_c2r')
  call Xfftw_destroy_plan(plan)
  deallocate(x2, y2, ref, tmp, xr, xi, yr, yi, r2, s2)

  ! threads, wisdom
  call Xfftw_init_threads(iret)
  call check(iret /= 0, 'PREC legacy init_threads')
  call Xfftw_plan_with_nthreads(2)
  call Xfftw_planner_nthreads(iret)
  call check(iret == 2, 'PREC legacy planner_nthreads')
  call Xfftw_plan_with_nthreads(1)
  allocate(x1(64), y1(64))
  call Xfftw_plan_dft_1d(plan, 64, x1, y1, FFTW_FORWARD, FFTW_ESTIMATE)
  wcount = 0
  call Xfftw_export_wisdom(wcount_char, iret)
  call check(wcount > 0, 'PREC legacy export_wisdom through a subroutine')
  call Xfftw_import_system_wisdom(iret)
  call check(iret == 0, 'PREC legacy import_system_wisdom without system wisdom')
  call Xfftw_forget_wisdom()
  call Xfftw_set_timelimit(1d0)
  call Xfftw_destroy_plan(plan)
  call Xfftw_cleanup_threads()
  call Xfftw_cleanup()
  deallocate(x1, y1)
end subroutine run_legacy_PREC
